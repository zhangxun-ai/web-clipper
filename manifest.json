{
  "manifest_version": 3,
  "name": "文档本地导出",
  "description": "将生财有术、公众号、普通网页和飞书文档的正文图片保存到指定飞书知识库，也支持本地导出。",
  "version": "0.4.9",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*",
    "https://*.larkoffice.com/*",
    "https://scys.com/*",
    "https://mp.weixin.qq.com/*",
    "https://mmbiz.qpic.cn/*",
    "https://mmsns.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "文档本地导出",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/docx/*",
        "https://*.feishu.cn/wiki/*",
        "https://*.larksuite.com/docx/*",
        "https://*.larksuite.com/wiki/*",
        "https://*.larkoffice.com/docx/*",
        "https://*.larkoffice.com/wiki/*",
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "wechat-markdown-cleanup.js",
        "shared/web-markdown-utils.js",
        "content-scripts/feishu-exporter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
